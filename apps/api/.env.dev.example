# ── DEV environment ──────────────────────────────────────────────────────────
# Copy this to .env.dev and fill in the values.
# .env.dev is gitignored — never commit real credentials.

# NeonDB dev branch connection string
# NeonDB dashboard → Branches → dev → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx-dev.us-east-2.aws.neon.tech/neondb?sslmode=require

# Same JWT secret as production is fine for dev (or use a different one)
JWT_SECRET=any-long-random-string-for-dev

# CORS: allow your local Expo/web client
CORS_ORIGIN=http://localhost:5173

# Port the API listens on locally
PORT=4000
