# PostgreSQL connection string (from Neon dashboard → your branch → Connection string)
DATABASE_URL=

# Secret used to sign JWTs — any long random string works (e.g. openssl rand -hex 32)
JWT_SECRET=

# Frontend origin allowed by CORS — use localhost for dev, your Render frontend URL for prod
CORS_ORIGIN=http://localhost:5173

# Port the API listens on — 4000 is the default if this is omitted
PORT=4000
